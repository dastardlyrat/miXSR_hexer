// Version: dream-morning-light-third-gate-1
// Capability: Portable Fibonacci bio global illumination driver with preset-tier budgeting, light/fog guards, and diagnostic tuning views.



#include "ReShade.fxh"
#include "FineCell_FogGate.fxh"
#include "FineCell_LightRespect.fxh"
#include "FineDream_Lens55Bounded.fxh"

uniform int FDGI_PresetTier <
    ui_type = "combo";
    ui_label = "Preset Tier";
    ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true;
    ui_items = "Basic Conservative\0Liberal Coverage\0Aggressive Aggregate\0High Fidelity\0Ultra Fidelity\0";
    ui_tooltip = "High Fidelity is the base standard; Ultra uses all bounded Lens55 taps without macro expansion.";
> = 3;

uniform int FDGI_DebugView <
    ui_type = "combo";
    ui_label = "Debug View";
    ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 00 Debug"; ui_category_closed = true;
    ui_items = "Final\0Local Light\0Application Mask\0Depth Gate\0Coverage Mask\0Computed Mask\0";
    ui_tooltip = "Shows final output or diagnostic masks.\nCoverage Mask shows sample confidence; Computed Mask shows final Global Illumination application after guards and fog restore.";
> = 0;

uniform float FDGI_MasterIntensity < ui_type = "slider"; ui_label = "Master Intensity"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 2.0; ui_step = 0.001; ui_tooltip = "Overall multiplier for Global Illumination response."; > = 1.000000;
uniform float FDGI_GIStrength < ui_type = "slider"; ui_label = "Global Illumination Strength"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 2.0; ui_step = 0.001; ui_tooltip = "How strongly sampled local light is added back into the scene."; > = 0.520000;
uniform float FDGI_RadiusPixels < ui_type = "slider"; ui_label = "Radius Pixels"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.25; ui_max = 32.0; ui_step = 0.01; ui_tooltip = "Base screen-space radius in pixels before tier scaling."; > = 5.500000;
uniform int FDGI_TapCount < ui_type = "slider"; ui_label = "Tap Budget"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 4; ui_max = FDREAM_LENS55_TAP_COUNT; ui_step = 1; ui_tooltip = "Bounded Lens55 tap budget. High and Ultra fidelity increase coverage without expanding the tap body."; > = 34;
uniform float FDGI_DepthFalloff < ui_type = "slider"; ui_label = "Depth Falloff"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.01; ui_max = 160.0; ui_step = 0.01; ui_tooltip = "Depth affinity slope for accepting nearby lighting samples."; > = 48.000000;
uniform float FDGI_DepthBias < ui_type = "slider"; ui_label = "Depth Bias"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 0.1000; ui_step = 0.0001; ui_tooltip = "Bias used when stabilizing Global Illumination depth affinity."; > = 0.001000;
uniform float FDGI_DepthGate < ui_type = "slider"; ui_label = "Depth Gate"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 1.0; ui_step = 0.001; ui_tooltip = "Suppresses Global Illumination when depth has weak signal or harsh discontinuities."; > = 0.600000;
uniform float FDGI_FibAnchor < ui_type = "slider"; ui_label = "Fibonacci Anchor"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 987.0; ui_max = 4181.0; ui_step = 1.0; ui_tooltip = "Anchor index for bio Fibonacci distribution."; > = 2584.000000;
uniform float FDGI_OrganicFlow < ui_type = "slider"; ui_label = "bio Flow"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 4.0; ui_step = 0.001; ui_tooltip = "Phase drift for Fibonacci-derived bio sample directions."; > = 1.350000;
uniform float FDGI_ColorBleedSaturation < ui_type = "slider"; ui_label = "Bleed Saturation"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 2.0; ui_step = 0.001; ui_tooltip = "Saturation of sampled indirect color."; > = 1.100000;
uniform float FDGI_MaxContribution < ui_type = "slider"; ui_label = "Max Contribution"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 3.0; ui_step = 0.001; ui_tooltip = "Upper cap for bounced light contribution."; > = 1.000000;
uniform int FDGI_RespectFog < ui_type = "combo"; ui_label = "Respect Fog"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_items = "No\0Yes\0"; ui_tooltip = "Bypasses Global Illumination in fog-dominant regions."; > = 1;
uniform int FDGI_RespectLight < ui_type = "combo"; ui_label = "Respect Light Emission"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_items = "No\0Yes\0"; ui_tooltip = "Protects emissive pixels from being dimmed or recolored."; > = 1;
uniform float FDGI_LightProtectStrength < ui_type = "slider"; ui_label = "Light Protect Strength"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 01 Guards (Respect Fog/Light)"; ui_category_closed = true; ui_min = 0.0; ui_max = 1.15; ui_step = 0.001; ui_tooltip = "How strongly protected lights return to the source color."; > = 0.900000;
uniform float FDGI_DebugExposure < ui_type = "slider"; ui_label = "Debug Exposure"; ui_category = "Fine Cell - Global Illumination - Guarded Bio Bounce / 00 Debug"; ui_category_closed = true; ui_min = 1.0; ui_max = 32.0; ui_step = 0.1; ui_tooltip = "Boosts debug buffer visibility."; > = 8.000000;

float2 FDGI_Pixel() { return float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT); }
float3 FDGI_Source(float2 uv) { return tex2D(ReShade::BackBuffer, saturate(uv)).rgb; }
float FDGI_RawDepth(float2 uv) { return tex2D(ReShade::DepthBuffer, saturate(uv)).r; }
float FDGI_Depth(float2 uv) { return saturate(ReShade::GetLinearizedDepth(saturate(uv))); }
float FDGI_Luma(float3 color) { return dot(color, float3(0.2126, 0.7152, 0.0722)); }
float3 FDGI_SaturateAroundLuma(float3 color, float amount) { float luma = FDGI_Luma(color); return lerp(luma.xxx, color, amount); }

int FDGI_TierTapCap()
{
    return FDREAM_Lens55TierTapCap(FDGI_PresetTier);
}

float FDGI_TierRadiusScale()
{
    return FDREAM_Lens55TierScale(FDGI_PresetTier);
}

float FDGI_TierStrengthScale()
{
    if (FDGI_PresetTier == 0) return 0.70;
    if (FDGI_PresetTier == 1) return 1.00;
    if (FDGI_PresetTier == 2) return 1.22;
    if (FDGI_PresetTier == 3) return 1.30;
    return 1.38;
}

float FDGI_TierDepthGateBias()
{
    if (FDGI_PresetTier == 0) return 0.15;
    if (FDGI_PresetTier == 1) return 0.00;
    return -0.10;
}

float FDGI_DebugScalar(float value)
{
    return pow(saturate(value * max(1.0, FDGI_DebugExposure)), 0.65);
}

float FDGI_LightEmissionMask(float3 sourceColor)
{
    if (FDGI_RespectLight == 0)
    {
        return 0.0;
    }

    return FC_LIGHT_EmissionMask(
        sourceColor,
        FDGI_Luma(sourceColor),
        0.680000,
        0.180000,
        0.700000,
        0.350000,
        0.220000,
        0.000010);
}

float FDGI_LocalLightZone(float2 uv, float3 sourceColor, float centerLightMask)
{
    if (FDGI_RespectLight == 0)
    {
        return 0.0;
    }

    float2 px = FDGI_Pixel() * 2.0;
    float zone = centerLightMask;
    zone = max(zone, FDGI_LightEmissionMask(FDGI_Source(uv + float2(px.x, 0.0))));
    zone = max(zone, FDGI_LightEmissionMask(FDGI_Source(uv - float2(px.x, 0.0))));
    zone = max(zone, FDGI_LightEmissionMask(FDGI_Source(uv + float2(0.0, px.y))));
    zone = max(zone, FDGI_LightEmissionMask(FDGI_Source(uv - float2(0.0, px.y))));
    return saturate(zone * FDGI_LightProtectStrength);
}

float FDGI_DepthActivity(float2 uv, float centerDepth)
{
    float2 px = FDGI_Pixel();
    float dR = FDGI_Depth(uv + float2(px.x, 0.0));
    float dL = FDGI_Depth(uv - float2(px.x, 0.0));
    float dU = FDGI_Depth(uv + float2(0.0, px.y));
    float dD = FDGI_Depth(uv - float2(0.0, px.y));
    float rawDepth = FDGI_RawDepth(uv);
    float rangeMask = step(0.000010, rawDepth) * step(rawDepth, 0.999990);
    float slope = abs(dR - dL) + abs(dU - dD);
    float centerFit = abs(dR - centerDepth) + abs(dL - centerDepth) + abs(dU - centerDepth) + abs(dD - centerDepth);
    float continuity = 1.0 - saturate((slope + centerFit * 0.25) * 28.0);
    return saturate(lerp(1.0, rangeMask * continuity, saturate(FDGI_DepthGate + FDGI_TierDepthGateBias())));
}

float2 FDGI_FibonacciDirection(float fibIndex)
{
    const float goldenAngle = 2.39996323;
    float angle = fibIndex * goldenAngle;
    return float2(cos(angle), sin(angle));
}

float2 FDGI_OrganicDirection(float2 lensOffset, float fibIndex, float2 uv, float tapNorm)
{
    float2 fibDir = FDGI_FibonacciDirection(fibIndex);
    float2 lensDir = normalize(float2(0.23 - lensOffset.y, 0.17 + lensOffset.x + frac(fibIndex * 0.000618)));
    float2 baseDir = normalize(lerp(lensDir, fibDir, 0.45 + 0.25 * tapNorm));
    float phase = fibIndex * 0.013 + FDGI_OrganicFlow * 0.21 + dot(uv * 72.0, float2(0.754, 0.569));
    float cs = cos(phase);
    float sn = sin(phase);
    return normalize(float2(baseDir.x * cs - baseDir.y * sn, baseDir.x * sn + baseDir.y * cs));
}

void FDGI_AccumulateTap(
    float2 uv,
    float centerDepth,
    float2 lensOffset,
    int tapIndex,
    int tapCount,
    inout float3 conservativeLight,
    inout float conservativeWeight,
    inout float3 liberalLight,
    inout float liberalWeight)
{
    if (tapIndex >= tapCount)
    {
        return;
    }

    float tapNorm = (float(tapIndex) + 0.5) / max(1.0, float(tapCount));
    float fibIndex = FDGI_FibAnchor + float(tapIndex);
    float2 direction = FDGI_OrganicDirection(lensOffset, fibIndex, uv, tapNorm);
    float radial = FDREAM_Lens55FibonacciGrowth(tapIndex, tapCount);
    float radiusPixels = FDGI_RadiusPixels * FDGI_TierRadiusScale();
    float2 sampleUv = uv + direction * FDGI_Pixel() * radiusPixels * radial;

    float3 sampleColor = FDGI_Source(sampleUv);
    float sampleDepth = FDGI_Depth(sampleUv);
    float depthDelta = sampleDepth - centerDepth;
    float falloff = max(0.01, FDGI_DepthFalloff);
    float conservativeAffinity = exp(-abs(depthDelta) * falloff);
    float liberalAffinity = exp(-abs(depthDelta) * falloff * 0.42);
    float tapWeight = 1.0 - 0.35 * tapNorm;

    conservativeLight += sampleColor * conservativeAffinity * tapWeight;
    conservativeWeight += conservativeAffinity * tapWeight;
    liberalLight += sampleColor * liberalAffinity * tapWeight;
    liberalWeight += liberalAffinity * tapWeight;
}

float4 FDGI_MainPS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    int tapCount = min(clamp(FDGI_TapCount, 1, FDREAM_LENS55_TAP_COUNT), FDGI_TierTapCap());
    float3 sourceColor = FDGI_Source(uv);
    float centerDepth = FDGI_Depth(uv);
    float depthGate = FDGI_DepthActivity(uv, centerDepth);

    float3 conservativeLight = sourceColor;
    float conservativeWeight = 1.0;
    float3 liberalLight = sourceColor;
    float liberalWeight = 1.0;

    [loop]
    for (int tapIndex = 0; tapIndex < FDREAM_LENS55_TAP_COUNT; ++tapIndex)
    {
        if (tapIndex < tapCount)
        {
            FDGI_AccumulateTap(uv, centerDepth, FDREAM_Lens55Offset(tapIndex), tapIndex, tapCount, conservativeLight, conservativeWeight, liberalLight, liberalWeight);
        }
    }

    float3 conservativeLocal = conservativeLight / max(0.000010, conservativeWeight);
    float3 liberalLocal = liberalLight / max(0.000010, liberalWeight);
    float aggregateBlend = (FDGI_PresetTier >= 4) ? 0.70 : ((FDGI_PresetTier == 3) ? 0.62 : ((FDGI_PresetTier == 2) ? 0.55 : ((FDGI_PresetTier == 1) ? 0.35 : 0.15)));
    float3 localLight = lerp(conservativeLocal, liberalLocal, aggregateBlend);
    localLight = FDGI_SaturateAroundLuma(localLight, FDGI_ColorBleedSaturation);
    float3 bounce = saturate(localLight - sourceColor);
    float strength = FDGI_GIStrength * FDGI_MasterIntensity * FDGI_TierStrengthScale();
    float lightProtectMask = FDGI_LightEmissionMask(sourceColor);
    float lightZone = FDGI_LocalLightZone(uv, sourceColor, lightProtectMask);
    float coverage = saturate((conservativeWeight + liberalWeight) / max(1.0, float(tapCount) * 2.0));
    float applicationMask = saturate(depthGate * lerp(coverage, 1.0, 0.35) * (1.0 - lightZone * 0.75));
    float3 giColor = saturate(sourceColor + bounce * strength * FDGI_MaxContribution * applicationMask);
    float3 protectedGI = FC_LIGHT_ProtectColor(giColor, sourceColor, lightProtectMask, FDGI_LightProtectStrength);
    float fogBypass = FC_FOG_BypassMask(uv, sourceColor, FDGI_RespectFog);
    float3 finalColor = lerp(protectedGI, sourceColor, fogBypass);
    float computedMask = applicationMask;
    if (FDGI_DebugView == 1) return float4(saturate(localLight), 1.0);
    if (FDGI_DebugView == 2) return float4(FDGI_DebugScalar(applicationMask).xxx, 1.0);
    if (FDGI_DebugView == 3) return float4(FDGI_DebugScalar(depthGate).xxx, 1.0);
    if (FDGI_DebugView == 4) return float4(FDGI_DebugScalar(coverage).xxx, 1.0);
    if (FDGI_DebugView == 5) return float4(FDGI_DebugScalar(computedMask).xxx, 1.0);

    return float4(saturate(finalColor), 1.0);
}

technique fine_dream_morning_light_Third_Gate < ui_label = "Fine Cell - Global Illumination - Guarded Bio Bounce"; ui_tooltip = "Portable Fibonacci bio Global Illumination driver with bounded Lens55 high/ultra fidelity tiers."; >
{
    pass
    {
        VertexShader = PostProcessVS;
        PixelShader = FDGI_MainPS;
    }
}







