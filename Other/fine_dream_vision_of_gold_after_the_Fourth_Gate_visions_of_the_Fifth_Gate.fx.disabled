    ui_type = "combo";
    ui_label = "Tone Map Final";
    ui_category = "Fine Cell - Bloom - Cinematic Three-Pass Star / 01 Guards (Respect Fog/Light)"; ui_category_closed = true;
    ui_items = "No\0Yes\0";
    ui_tooltip = "Applies a soft tonemap to protect highlights after bloom composite.";
> = 0;

texture2D FDVGOLD_CoreTex
{
    Width = BUFFER_WIDTH / FDVGOLD_BUFFER_SCALE_LITERAL;
    Height = BUFFER_HEIGHT / FDVGOLD_BUFFER_SCALE_LITERAL;
    Format = RGBA16F;
};

texture2D FDVGOLD_PhotosphereTex
{
    Width = BUFFER_WIDTH / FDVGOLD_BUFFER_SCALE_LITERAL;
    Height = BUFFER_HEIGHT / FDVGOLD_BUFFER_SCALE_LITERAL;
    Format = RGBA16F;
};

texture2D FDVGOLD_CoronaTex
{
    Width = BUFFER_WIDTH / FDVGOLD_BUFFER_SCALE_LITERAL;
    Height = BUFFER_HEIGHT / FDVGOLD_BUFFER_SCALE_LITERAL;
    Format = RGBA16F;
};

sampler2D FDVGOLD_CoreSampler
{
    Texture = FDVGOLD_CoreTex;
};

sampler2D FDVGOLD_PhotosphereSampler
{
    Texture = FDVGOLD_PhotosphereTex;
};

sampler2D FDVGOLD_CoronaSampler
{
    Texture = FDVGOLD_CoronaTex;
};

float2 FDVGOLD_Pixel() { return float2(BUFFER_RCP_WIDTH, BUFFER_RCP_HEIGHT); }
float2 FDVGOLD_BloomPixel() { return FDVGOLD_Pixel() * FDVGOLD_BUFFER_SCALE_LITERAL; }
float3 FDVGOLD_Source(float2 uv) { return tex2D(ReShade::BackBuffer, saturate(uv)).rgb; }
float3 FDVGOLD_CoreSource(float2 uv) { return tex2D(FDVGOLD_CoreSampler, saturate(uv)).rgb; }
float3 FDVGOLD_PhotosphereSource(float2 uv) { return tex2D(FDVGOLD_PhotosphereSampler, saturate(uv)).rgb; }
float3 FDVGOLD_CoronaSource(float2 uv) { return tex2D(FDVGOLD_CoronaSampler, saturate(uv)).rgb; }
float FDVGOLD_Luma(float3 c) { return dot(c, float3(0.2126, 0.7152, 0.0722)); }

float FDVGOLD_Hash12(float2 p)
{
    return frac(sin(dot(p, float2(127.1, 311.7))) * 43758.5453);
}

float3 FDVGOLD_ApplyWhiteGoldTone(float3 color)
{
    float3 whiteGold = float3(1.0, 0.965, 0.90);
    float3 warmed = lerp(color, color * whiteGold, saturate(FDVGOLD_WhiteGoldWarmth));
    float luma = FDVGOLD_Luma(warmed);
    return lerp(luma.xxx, warmed, FDVGOLD_BloomSaturation);
}

float FDVGOLD_CoreMask(float3 sourceColor)
{
    float sourceLuma = FDVGOLD_Luma(sourceColor);
    return smoothstep(
        FDVGOLD_CoreThreshold,
        FDVGOLD_CoreThreshold + max(0.00001, FDVGOLD_CoreSoftness),
        sourceLuma);
}

float FDVGOLD_QualityScale()
{
    if (FDVGOLD_QualityTier == 0) return 0.42;
    if (FDVGOLD_QualityTier == 1) return 0.62;
    if (FDVGOLD_QualityTier == 2) return 0.80;
    return 1.00;
}

int FDVGOLD_PhotosphereSampleCount()
{
    float scale = saturate(FDVGOLD_RayBudgetScale) * FDVGOLD_QualityScale();
    int count = (int)floor(12.0 * scale + 0.5);
    return clamp(count, 3, 12);
}

int FDVGOLD_CoronaSampleCount()
{
    float scale = saturate(FDVGOLD_RayBudgetScale) * FDVGOLD_QualityScale();
    int count = (int)floor(16.0 * scale + 0.5);
    return clamp(count, 4, 16);
}

float4 FDVGOLD_CorePassPS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float2 px = FDVGOLD_Pixel();
    float3 c = FDVGOLD_Source(uv);
    float m = FDVGOLD_CoreMask(c);
    float2 r = px * FDVGOLD_CoreRadiusPixels;

    float3 axis = 0.0;
    axis += FDVGOLD_Source(uv + float2(r.x, 0.0));
    axis += FDVGOLD_Source(uv + float2(-r.x, 0.0));
    axis += FDVGOLD_Source(uv + float2(0.0, r.y));
    axis += FDVGOLD_Source(uv + float2(0.0, -r.y));
    axis *= 0.25;

    float mAxis = 0.0;
    mAxis += FDVGOLD_CoreMask(FDVGOLD_Source(uv + float2(r.x, 0.0)));
    mAxis += FDVGOLD_CoreMask(FDVGOLD_Source(uv + float2(-r.x, 0.0)));
    mAxis += FDVGOLD_CoreMask(FDVGOLD_Source(uv + float2(0.0, r.y)));
    mAxis += FDVGOLD_CoreMask(FDVGOLD_Source(uv + float2(0.0, -r.y)));
    mAxis *= 0.25;

    float3 coreColor = (c * m + axis * mAxis) * 0.5;
    coreColor = FDVGOLD_ApplyWhiteGoldTone(coreColor) * FDVGOLD_CoreIntensity;
    return float4(coreColor, 1.0);
}

float4 FDVGOLD_PhotospherePassPS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float2 px = FDVGOLD_BloomPixel();
    float coreRadius = max(0.5, FDVGOLD_CoreRadiusPixels);
    float ringStart = coreRadius * min(FDVGOLD_PhotosphereStartCoreMul, FDVGOLD_PhotosphereEndCoreMul);
    float ringEnd = coreRadius * max(FDVGOLD_PhotosphereStartCoreMul, FDVGOLD_PhotosphereEndCoreMul);
    float ringMid = 0.5 * (ringStart + ringEnd);

    float3 halo = 0.0;
    float weight = 0.0;

    int sampleCount = FDVGOLD_PhotosphereSampleCount();
    float sampleCountF = max(1.0, float(sampleCount));

    for (int i = 0; i < 12; ++i)
    {
        // Cost-responsive gating: inactive taps skip trig and texture fetches entirely.
        if (i < sampleCount)
        {
            float t = (float(i) + 0.5) / sampleCountF;
            float angle = t * 6.28318530718;
            float2 dir = float2(cos(angle), sin(angle));

            float3 sA = FDVGOLD_CoreSource(uv + dir * px * ringStart);
            float3 sB = FDVGOLD_CoreSource(uv + dir * px * ringMid);
            float3 sC = FDVGOLD_CoreSource(uv + dir * px * ringEnd);

            float wA = 0.85;
            float wB = 1.0;
            float wC = 0.85;

            halo += (sA * wA + sB * wB + sC * wC);
            weight += (wA + wB + wC);
        }
    }

    halo /= max(0.00001, weight);
    float haloLuma = pow(saturate(FDVGOLD_Luma(halo)), max(0.5, FDVGOLD_PhotosphereHaloSharpness));
    halo *= haloLuma * FDVGOLD_PhotosphereIntensity;
    halo = FDVGOLD_ApplyWhiteGoldTone(halo);
    return float4(halo, 1.0);
}

float4 FDVGOLD_CoronaPassPS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float2 px = FDVGOLD_BloomPixel();
    float coreRadius = max(0.5, FDVGOLD_CoreRadiusPixels);
    float coronaStart = coreRadius * min(FDVGOLD_CoronaStartCoreMul, FDVGOLD_CoronaEndCoreMul);
    float coronaEnd = coreRadius * max(FDVGOLD_CoronaStartCoreMul, FDVGOLD_CoronaEndCoreMul);
    float span = max(0.00001, coronaEnd - coronaStart);
    float phase = FDVGOLD_Hash12(uv * float2(BUFFER_WIDTH, BUFFER_HEIGHT)) * 6.28318530718;

    float3 corona = 0.0;
    float totalWeight = 0.0;

    int sampleCount = FDVGOLD_CoronaSampleCount();
    float sampleCountF = max(1.0, float(sampleCount));

    for (int i = 0; i < 16; ++i)
    {
        // Cost-responsive gating: inactive taps skip trig and texture fetches entirely.
        if (i < sampleCount)
        {
            float t = (float(i) + 0.5) / sampleCountF;
            float angle = t * 6.28318530718;
            float erupt = pow(saturate(0.5 + 0.5 * sin(angle * max(2.0, FDVGOLD_CoronaEruptionCount) + phase)), max(0.5, FDVGOLD_CoronaEruptionSharpness));
            float jitter = lerp(0.75, 1.30, FDVGOLD_Hash12(float2(float(i) * 13.1, float(i) * 7.7) + uv * 31.0));
            float2 dir = float2(cos(angle), sin(angle));

            float r0 = coronaStart + span * 0.20 * jitter;
            float r1 = coronaStart + span * 0.55 * jitter;
            float r2 = coronaStart + span * 0.90 * jitter;

            float3 p0 = FDVGOLD_PhotosphereSource(uv + dir * px * r0);
            float3 p1 = FDVGOLD_PhotosphereSource(uv + dir * px * r1);
            float3 p2 = FDVGOLD_PhotosphereSource(uv + dir * px * r2);
            float3 coreMid = FDVGOLD_CoreSource(uv + dir * px * r1) * 0.35;

            float w0 = (0.80 + 0.20 * erupt);
            float w1 = (1.00 + 0.40 * erupt);
            float w2 = (0.90 + 0.60 * erupt);

            corona += (p0 * w0 + (p1 + coreMid) * w1 + p2 * w2);
            totalWeight += (w0 + w1 + w2);
        }
    }

    corona /= max(0.00001, totalWeight);
    corona *= FDVGOLD_CoronaIntensity;
    corona = FDVGOLD_ApplyWhiteGoldTone(corona);
    return float4(corona, 1.0);
}

float4 FDVGOLD_FinalCompositePS(float4 position : SV_Position, float2 uv : TEXCOORD) : SV_Target
{
    float3 sourceColor = FDVGOLD_Source(uv);
    float3 coreColor = FDVGOLD_CoreSource(uv);
    float3 photosphereColor = FDVGOLD_PhotosphereSource(uv);
    float3 coronaColor = FDVGOLD_CoronaSource(uv);

    float coreMask = saturate(FDVGOLD_CoreMask(sourceColor));
    float coreHot = saturate(FDVGOLD_Luma(sourceColor) * 1.35);
    float coreProtect = saturate(coreMask * coreHot * FDVGOLD_CoreRespectStrength);

    float3 coreContribution = coreColor;
    if (FDVGOLD_CorePolicy == 1)
    {
        coreContribution *= (1.0 - coreProtect);
    }

    float3 bloom = coreContribution + photosphereColor + coronaColor;
    bloom *= FDVGOLD_MasterIntensity;

    float3 finalColor = sourceColor + bloom;
    if (FDVGOLD_ToneMapFinal == 1)
    {
        finalColor = finalColor / (1.0 + finalColor);
    }

    if (FDVGOLD_DebugView == 1) return float4(coreColor, 1.0);
    if (FDVGOLD_DebugView == 2) return float4(photosphereColor, 1.0);
    if (FDVGOLD_DebugView == 3) return float4(coronaColor, 1.0);
    if (FDVGOLD_DebugView == 4) return float4(bloom, 1.0);
    return float4(finalColor, 1.0);
}

technique fine_dream_vision_of_gold_after_the_Fourth_Gate_visions_of_the_Fifth_Gate <
    ui_label = "Fine Cell - Bloom - Cinematic Three-Pass Star";
    ui_tooltip = "Three-pass light source bloom: core, photosphere halo, and eruptive corona.";
>
{
    pass
    {
        VertexShader = PostProcessVS;
        PixelShader = FDVGOLD_CorePassPS;
        RenderTarget = FDVGOLD_CoreTex;
    }

    pass
    {
        VertexShader = PostProcessVS;
        PixelShader = FDVGOLD_PhotospherePassPS;
        RenderTarget = FDVGOLD_PhotosphereTex;
    }

    pass
    {
        VertexShader = PostProcessVS;
        PixelShader = FDVGOLD_CoronaPassPS;
        RenderTarget = FDVGOLD_CoronaTex;
    }

    pass
    {
        VertexShader = PostProcessVS;
        PixelShader = FDVGOLD_FinalCompositePS;
    }
}





